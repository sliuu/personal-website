---
// A bordered callout with an optional pixel icon — the site's "card" primitive.
// Used inside case studies, usually three-up in a .cols-3 grid.
import { icons, type IconName } from './icons';

interface Props {
  icon?: IconName;
  text: string;
}
const { icon, text } = Astro.props;
---
<div class="callout">
  {icon && (
    <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" class="minisvg" viewBox="0 0 24 24" aria-hidden="true">
      <path d={icons[icon]} />
    </svg>
  )}
  <p>{text}</p>
</div>

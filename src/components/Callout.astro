---
// A bordered callout with an optional pixel icon — the site's "card" primitive.
// Used inside case studies, usually three-up in a .cols-3 grid.
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  icon?: IconName;
  text: string;
}
const { icon, text } = Astro.props;
---
<div class="callout">
  {icon && <Icon name={icon} />}
  <p>{text}</p>
</div>

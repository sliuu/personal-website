---
// src/components/PullQuote.astro — a sentence lifted out of the flow.
//
// A rule down the left rather than a box, for the same reason <Panel> and
// .callout use rules: this is a document. The rule is 2px and in the accent —
// heavier than the hairlines everywhere else, because it is the only thing
// marking the passage and a 1px line at this type size disappears.
//
// `cite` is optional and NOT decoration: if the words are someone else's, they
// need attributing. If they are the author's own summary of the work, leave it
// off and don't wrap the text in quotation marks — an unattributed sentence in
// quote marks reads as a research participant who may not exist.
interface Props {
  cite?: string;
}
const { cite } = Astro.props;
---
<!-- data-snap-box, and the tagger skips blockquote.pullquote so this does NOT
     also get data-snap. It used to get only the latter, which is what put it
     off the grid: the accent rule is a border, a baseline transform carries
     borders with it, and nothing was pinning the box to a line in the first
     place. Now the box snaps and the <p> inside takes the baseline shift —
     the same split .callout, Panel and SectionHeading use.

     No <p> around the slot. MDX already wraps the block content between the
     tags in one, and <p><p>text</p></p> is not parseable nesting — the browser
     split it into THREE paragraphs, the real one plus an empty one either
     side, each of which the tagger then dutifully snapped. They were invisible
     (empty blocks draw no line box) but they were being measured. -->
<blockquote class="pullquote" data-snap-box>
  <slot />
  {cite && <cite>{cite}</cite>}
</blockquote>

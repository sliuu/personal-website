---
// src/components/IconLink.astro — a nav link that is an icon instead of a word.
//
// Stroked, not filled, and drawn on the same 24×24 box as the header mark, so
// the row reads as one set. --icon-stroke is heavier than the mark's 1.1:
// these render at --icon-size (16px) where the mark renders at 28, and a
// hairline that survives 28px disappears at 16.
//
// The link is the tap target, not the glyph — a --icon-btn square (28px, just
// under a full grid row so the ring never touches a painted line), so the
// icons keep a hit area without visible padding.
//
// The glyphs themselves live in Glyph.astro; the mail one is shared with the
// "Get in touch" buttons.
import Glyph from './Glyph.astro';

export interface Props {
  href: string;
  /** Announced to screen readers and shown as the native tooltip. */
  label: string;
  icon: 'github' | 'linkedin' | 'mail';
}
const { href, label, icon } = Astro.props;

// mailto: and in-page anchors stay in the tab; anything with a scheme leaves.
const isExternal = href.startsWith('http');
---
<a
  class="icon-link"
  href={href}
  aria-label={label}
  title={label}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener' : undefined}
>
  <Glyph name={icon} />
</a>

<style>
  /* A ring, slightly under a full grid row so it floats between two lines
     rather than sitting tangent to them. The ring is also the tap target, so
     the glyph gets a comfortable hit area without any visible padding. */
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--icon-btn);
    height: var(--icon-btn);
    border: 1px solid var(--color-stroke-neutral);
    border-radius: 50%;
    color: var(--color-icon);
    /* --dur, not three copies of 0.15s — same number, but the token is the
       one that moves if the site's hover speed ever changes. transform is
       here rather than in global.css because this scoped selector outranks
       anything unscoped, so a transition declared there would be discarded;
       the :active rule itself still lives in global.css with the other two
       controls that share it. */
    transition:
      color var(--dur), border-color var(--dur), background-color var(--dur),
      transform var(--dur-press) var(--ease-out);
  }
  /* same hover language as .work-row and .career-box: a faint accent wash */
  .icon-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: rgba(var(--accent-rgb), 0.06);
  }
  /* The press. --press-scale-sm alone is only 2.8px of travel on a 28px ring,
     which is still faint, so the wash carries most of it — a colour step is
     the one cue that reads the same whatever size the box is. This can live
     in the component (unlike the transform) because `background` is not
     declared for .icon-link in global.css, so nothing there outranks it.

     0.14 is well past the 0.08 ceiling the --tint-* family keeps, and that is
     allowed here for the reason the ceiling exists: that limit protects a
     large FILL from reading as a block of colour. This is a 28px circle held
     for a fraction of a second. */
  .icon-link:active {
    background: rgba(var(--accent-rgb), 0.14);
    border-color: var(--color-accent);
  }
  /* The glyph's own size and stroke are Glyph.astro's — Astro scopes styles
     per component, so a rule written here could not reach it anyway. This
     ring wants the default --icon-size, so it overrides nothing. */
</style>

---
// src/layouts/BaseLayout.astro
// Shared chrome for every page: head, fonts, tokens, the grid background,
// the header, the footer, and the two grid behaviors (mouse spotlight +
// baseline snapping). Ported from the classical redesign handoff
// (handoff/portfolio-standalone.html).
//
// The whole system hangs off one knob: --grid (32px). Every vertical
// measurement is a multiple of it, so each line box is a whole number of
// grid rows and the stack stays aligned with the painted background.
//
// Global CSS lives in real stylesheets — Astro bundles these exactly as it
// would an inline <style is:global> block. Page-specific rules stay in each
// page's own scoped <style>.
import '../styles/tokens.css';
import '../styles/global.css';
import IconLink from '../components/IconLink.astro';
import Mark from '../components/Mark.astro';
import {
  SITE_TITLE, SITE_DESCRIPTION,
  GITHUB_URL, LINKEDIN_URL, EMAIL_URL, SOURCE_URL,
} from '../consts';

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// 1200x630, the 1.91:1 every card renderer crops toward, and cropped in on the
// right of the frame so a face survives at thumbnail size — the wide version
// on the homepage would put her about twelve pixels tall in a Slack unfurl.
// Was /favicon.png, which previewed every shared link as a 512px icon.
const ogImage = new URL("/me-og.jpg", Astro.site);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Stephanie on a rooftop at dusk, with the hills of San Francisco behind her" />
    <!-- summary_large_image, not summary: the card is now a 1.91:1 photograph,
         and `summary` would letterbox it into a small square thumbnail. -->
    <meta name="twitter:card" content="summary_large_image" />

    <!-- SVG first for browsers that take it (stays crisp at any size); the
         PNG is the fallback. /favicon.ico is probed automatically. -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Merriweather (variable, 300-600 used) for --font-read; Epilogue 400/600
         for --font-ui. No 700 is loaded, so nothing gets a synthesized bold.
         Merriweather is requested as a range, not discrete weights: font-weight 500
         is used by h4 and a discrete list would leave it synthesized. Epilogue
         stays discrete — --font-ui only ever sets 400 and 600, and a range
         would ship the whole 100-900 axis to serve two of them. -->
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300..600;1,300..600&family=Epilogue:wght@400;600&display=swap" rel="stylesheet" />

    <!-- Gates the load fade on JS being alive. Inline and in the head so the
         class lands before first paint — a deferred module would flip it after
         the page had already shown, which is the flash the fade exists to
         avoid. is:inline keeps Astro from bundling and deferring it. -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body>
    <div class="page" data-grid-root>
      <div class="glow"></div>
      <!-- Outside .wrap on purpose. The masthead is sticky, so it sits above
           the column that scrolls rather than inside it. (.wrap used to cap
           the page at 1280 as well, which was the other half of the reason;
           that cap is gone now — it was pushing every edge below it off the
           vertical grid. See .col in global.css.) -->
      <header class="header">
        <a href="/" class="mark" aria-label="Home">
          <!-- currentColor: the `a` rule in global.css already paints this
               the accent, and hands it the hover brightening for free. -->
          <Mark />
        </a>
        <!-- No data-snap here any more: baseline snapping measures font
             metrics, and there is no text left to measure. The row lands on
             the grid by construction instead — see .nav in global.css. -->
        <nav class="nav">
          <IconLink href={GITHUB_URL} icon="github" label="GitHub" />
          <IconLink href={LINKEDIN_URL} icon="linkedin" label="LinkedIn" />
          <IconLink href={EMAIL_URL} icon="mail" label="Email" />
        </nav>
      </header>

      <div class="wrap">
        <div class="col">
          <slot />

          <hr class="hr" data-snap-box />
          <div class="footer" data-snap>
            <span>&copy; 2026 stephanie liu</span>
            <a href={SOURCE_URL} target="_blank" rel="noopener">code for this site &#8599;</a>
          </div>
        </div>
      </div>
    </div>

    <script>
      const root = document.querySelector<HTMLElement>("[data-grid-root]");
      if (!root) throw new Error("grid root not found");

      /* 1) Mouse spotlight. Writing --mx/--my repaints a viewport-sized mask,
            so coalesce moves into one write per frame. */
      const glow = root.querySelector<HTMLElement>(".glow");
      if (glow && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        let pending: MouseEvent | null = null;
        root.addEventListener("mousemove", (e) => {
          const first = pending === null;
          pending = e;
          if (!first) return;
          requestAnimationFrame(() => {
            const e2 = pending!;
            pending = null;
            const r = root.getBoundingClientRect();
            glow.style.setProperty("--mx", e2.clientX - r.left + "px");
            glow.style.setProperty("--my", e2.clientY - r.top + "px");
            glow.classList.add("is-lit");
          });
        });
        root.addEventListener("mouseleave", () => { glow.classList.remove("is-lit"); });
      }

      /* 2) Baseline snap onto the grid */

      // Measured, not parsed. An unregistered custom property computes to its
      // literal token string, so reading --grid gives "2rem" — any arithmetic
      // on that also hardcodes the unit and the root font size, and silently
      // returns nonsense the day the token is authored in px. A probe element
      // sized by the token reports whatever the token actually resolves to.
      const probe = document.createElement("div");
      probe.style.cssText =
        "position:absolute;visibility:hidden;pointer-events:none;width:var(--grid);height:0";
      function gridSize() {
        root!.appendChild(probe);
        const px = probe.getBoundingClientRect().width;
        probe.remove();
        return px || 32;
      }

      // Markdown bodies can't carry snap attributes by hand, so a container
      // marked [data-snap-all] gets its text blocks tagged at runtime. Runs
      // once — the tagged content is static after hydration.
      function tagSnapTargets() {
        root!.querySelectorAll("[data-snap-all]").forEach((container) => {
          container
            // Two exclusions, one reason: chrome belongs to the block it
            // labels, not to the grid.
            //
            // No figcaption. A caption belongs to the picture above it: an
            // image is an arbitrary number of pixels tall, so snapping the
            // caption to the nearest line set its distance from the image by
            // whatever the image height happened to leave — measured across
            // one page, anywhere from 12px OVERLAPPING the picture to 15px
            // below it. A fixed offset is the even one.
            //
            // No .callout-label. The label sits one row above its text and
            // the snap was translating it 11.5px DOWN — closing a 27px gap to
            // 15px and crowding the thing it introduces. The label rides its
            // own row instead, which the callout's padding already put in the
            // right place. (Its sibling in the rail, .rail-label, drops the
            // attribute in Contents.astro for the same reason.) Costs nothing
            // below it: the baseline pass is a transform, not a reflow.
            //
            // See figcaption and .callout-label in pages/projects/[id].astro.
            .querySelectorAll("p:not(.callout-label), li, dt, dd, blockquote, h1, h2, h3, h4, h5, h6")
            .forEach((el) => el.setAttribute("data-snap", ""));
          // Re-pin the flow after anything of arbitrary height (images).
          // .callout is here for its border: a box-snap puts its top edge on a
          // line, which a baseline-snap would then shift back off.
          container
            .querySelectorAll("h2, h3, h4, .callout")
            .forEach((el) => el.setAttribute("data-snap-box", ""));
        });
      }

      let ctx: CanvasRenderingContext2D | null = null;
      let boxes: HTMLElement[] = [];
      let lines: HTMLElement[] = [];

      function collect() {
        tagSnapTargets();
        boxes = Array.from(root!.querySelectorAll<HTMLElement>("[data-snap-box]"));
        lines = Array.from(root!.querySelectorAll<HTMLElement>("[data-snap]"));
      }

      function snapToGrid() {
        const grid = gridSize();
        ctx = ctx || document.createElement("canvas").getContext("2d");
        if (!ctx) return;

        // Clear every baseline transform before measuring anything. An element
        // can carry both attributes, and getBoundingClientRect() reports the
        // transformed position — so a leftover translateY from the last pass
        // would poison the box-edge math below.
        for (const el of lines) el.style.transform = "";

        // Measure sticky subtrees where they LIVE, not where they are pinned.
        //
        // Every position below is `rect.top - rootRect()`. Once `position:
        // sticky` engages, an element's rect stops moving while the grid root's
        // top keeps scrolling away, so that subtraction returns the pinned
        // position PLUS scrollY — a place the element occupies only while the
        // page sits at that exact offset. Snap against it and the corrections
        // are computed for a frame the element leaves the moment you scroll.
        //
        // It does not merely offset the block uniformly, which is why the
        // symptom is uneven rather than a clean shift: the correction is
        // Math.round(baseline / grid) * grid - baseline, and adding the same
        // scroll offset to every row does not rotate all the roundings
        // together. Two rows whose baselines differ by a non-multiple of the
        // grid can round OPPOSITE ways, opening or closing a full row between
        // them. The rail has exactly those residuals — the section seam is a
        // 1px border plus (grid - 1px) of padding, and its contents rows align
        // to `start` across two type tracks.
        //
        // The bug this fixes: coming back to a project page through history.
        // The browser restores the old scroll position before the later settle
        // passes run, so every pass after the first measured a pinned rail and
        // left it visibly off the lines until a reload. A fresh load starts at
        // scroll 0, where the rail is at rest, and never showed it.
        //
        // Safe because static and sticky produce an IDENTICAL layout box —
        // sticky changes only where the box is painted — so nothing else on the
        // page moves while this is in force, and no frame is painted in
        // between: everything from here to the end of the function is
        // synchronous. An internal scroll offset poisons the same arithmetic
        // the same way (a rail scrolled inside itself reports its rows shifted
        // by scrollTop), so it is zeroed and restored alongside.
        const pinned = Array.from(
          root!.querySelectorAll<HTMLElement>("[data-snap-sticky]"),
        );
        const parked = pinned.map((el) => el.scrollTop);
        for (const el of pinned) {
          el.style.position = "static";
          el.scrollTop = 0;
        }

        // (a) Box-edge snap FIRST — adjusts margin-top (reflows) so bordered
        // rows land on the grid. Read-then-write per element is unavoidable
        // here: each nudge moves everything below it, so element N+1 cannot be
        // measured until N has been placed.
        const rootRect = () => root!.getBoundingClientRect().top;
        for (const el of boxes) {
          const prev = parseFloat(el.dataset.boxNudge || "0");
          const base = parseFloat(getComputedStyle(el).marginTop) - prev; // idempotent
          el.style.marginTop = base + "px";
          const top = el.getBoundingClientRect().top - rootRect();
          let nudge = Math.round(top / grid) * grid - top;
          el.style.marginTop = base + nudge + "px";

          // Adjacent siblings' vertical margins COLLAPSE to the larger of the
          // two, so a nudge smaller than the margin above is swallowed whole
          // and the element never moves. Push whole extra rows until it wins.
          for (let i = 0; i < 3; i++) {
            const now = el.getBoundingClientRect().top - rootRect();
            if (Math.abs(now - Math.round(now / grid) * grid) < 0.5) break;
            nudge += grid;
            el.style.marginTop = base + nudge + "px";
          }
          el.dataset.boxNudge = String(nudge);
        }

        // (b) Text baseline snap — transform (no reflow), so every element can
        // be measured before any is moved. Batch the reads, then the writes.
        const rootTop = rootRect();
        const shifts: number[] = [];
        for (const el of lines) {
          const s = getComputedStyle(el);
          const fs = parseFloat(s.fontSize);
          const lh = parseFloat(s.lineHeight) || fs;
          ctx.font = `${s.fontStyle} ${s.fontWeight} ${fs}px ${s.fontFamily}`;
          const m = ctx.measureText("Hxgp");
          const asc = m.fontBoundingBoxAscent || fs * 0.8;
          const desc = m.fontBoundingBoxDescent || fs * 0.2;
          const top = el.getBoundingClientRect().top - rootTop;
          const baseline = top + (lh - (asc + desc)) / 2 + asc;
          shifts.push(Math.round(baseline / grid) * grid - baseline);
        }
        lines.forEach((el, i) => { el.style.transform = `translateY(${shifts[i]}px)`; });

        // Sticky back on. After the writes, not before: the transforms above
        // are relative to each element's layout position, which is what was
        // just measured, so restoring earlier would change nothing — but doing
        // it last keeps the whole measure-and-place sequence in one frame of
        // reference.
        pinned.forEach((el, i) => {
          el.style.position = "";
          el.scrollTop = parked[i];
        });
      }

      function resnap() { collect(); snapToGrid(); }

      // Settle passes so the first alignment holds on a cold load (fonts,
      // layout and metrics finish at different times). setTimeout — not rAF —
      // because requestAnimationFrame is throttled in background tabs and
      // screenshot contexts and may never fire.
      let settleTimers: number[] = [];
      function scheduleSnaps() {
        settleTimers.forEach(clearTimeout);
        resnap();
        settleTimers = [60, 200, 500].map((t) => setTimeout(snapToGrid, t));
      }
      if (document.readyState === "loading") addEventListener("DOMContentLoaded", scheduleSnaps);
      else scheduleSnaps();

      /* 3) Reveal. The page is held at opacity 0 by .js .page (global.css)
            until the faces have loaded and the first baseline pass has run, so
            the settle happens behind the fade instead of in front of the
            reader. resnap() inside scheduleSnaps is synchronous, so calling
            reveal on the next line means the grid is already applied.

            The timeout is not a nicety. fonts.ready can hang on a slow or
            blocked Google Fonts response, and the failure mode of this whole
            arrangement is a permanently blank page — so the reveal fires on
            whichever comes first. 1s is past a warm load and short enough that
            a cold one degrades to "fonts swap in visibly", the behaviour the
            site had before the fade. */
      /* Two frames, not zero. A transition needs a painted starting value: on
         a warm font cache fonts.ready resolves in the first microtask batch,
         before the browser has drawn a single frame at opacity 0, and the
         reveal then has no `from` to animate out of — the page snaps in and
         the fade never runs. One rAF gets us into a frame, the second lands
         after it has been painted. (The snap passes below still use setTimeout
         for the reason given above; this one can use rAF because the 1s
         backstop covers the throttled-tab case where it never fires.) */
      const reveal = () =>
        requestAnimationFrame(() =>
          requestAnimationFrame(() => root.classList.add("is-ready")),
        );
      (document.fonts ? document.fonts.ready : Promise.resolve()).then(() => {
        scheduleSnaps();
        reveal();
      });
      setTimeout(() => root.classList.add("is-ready"), 1000);
      addEventListener("load", scheduleSnaps);

      // Resize fires in bursts and a pass forces layout, so run at most one
      // per frame.
      let queued = false;
      addEventListener("resize", () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => { queued = false; snapToGrid(); });
      });

      // Pages whose content changes size (e.g. the role dropdown) ask for a
      // re-snap. Re-collects, since the change may have added or removed rows.
      document.addEventListener("grid:resnap", resnap);
    </script>
  </body>
</html>

---
// src/pages/404.astro — shown by the host for any unknown URL
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="not found — stephanie liu">
  <div>
    <p class="oops">this page doesn't exist</p>
    <p class="hint"><a href="/">&larr; back to stephanie liu</a></p>
  </div>
</BaseLayout>

<style>
  .oops {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: calc(var(--grid) * 1.5);
    letter-spacing: -0.01em;
  }
  .hint { font-size: var(--text-base); line-height: var(--grid); }

  @media (max-width: 640px) {
    .oops { font-size: var(--text-lg); line-height: var(--grid); }
  }
</style>

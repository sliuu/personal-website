---
// src/pages/projects/[id].astro — renders every project from the collection
// https://pixelarticons.com/
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Tell Astro which pages to build — one per markdown file in content/projects/
export async function getStaticPaths() {
  // Skip drafts/archived — no page is built for them.
  const projects = (await getCollection('projects')).filter((p) => !p.data.draft);
  return projects.map((project) => ({
    params: { id: project.id },   // the URL slug, from the filename
    props: { project },           // hand the whole entry to the page below
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);   // markdown body → renderable component

// Ordered list (newest first) so we can offer a "next case study" link.
// Exclude drafts so archived projects never surface as "Next".
const all = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title));
const index = all.findIndex((p) => p.id === project.id);
const next = all[(index + 1) % all.length];   // wraps around to the first

const linkedinUrl = "https://www.linkedin.com/in/stephanieliu14";
---
<BaseLayout title={`${project.data.title} — stephanie liu`} description={project.data.summary}>
  <!-- data-snap-all: the markdown body can't carry snap attributes by hand,
       so the layout's script tags its text blocks at runtime -->
  <article data-snap-all>
    <a class="back" href="/" aria-label="back to home" data-snap>&larr;</a>
    <h1 data-snap>{project.data.title}</h1>

    <div class="summary" data-snap data-snap-box>{project.data.summary}</div>
    <dl class="meta-block" data-snap-box>
      <div><dt>Team</dt><dd>{project.data.team}</dd></div>
      <div><dt>Role</dt><dd>{project.data.role}</dd></div>
      <div><dt>Date</dt><dd>{project.data.date}</dd></div>
      <div><dt>Tools</dt><dd>{project.data.tech.join(", ")}</dd></div>
      {project.data.repo && (
        <div><dt>Code</dt><dd><a href={project.data.repo} target="_blank" rel="noopener">GitHub &#8599;</a></dd></div>
      )}
    </dl>

    <Content />

    <!-- data-snap-box only: this box has a border, so its top edge is what
         gets snapped. A data-snap here would translate the border too — the
         links carry the baseline snap instead. -->
    <footer class="case-footer" data-snap-box>
      <a class="case-footer__home" href="/" data-snap>&larr; All work</a>
      <a class="case-footer__next" href={`/projects/${next.id}`} data-snap>
        Next: {next.data.title} &rarr;
      </a>
    </footer>
    <p class="case-cta" data-snap>Want to talk? <a href={linkedinUrl} target="_blank" rel="noopener">Get in touch &#8599;</a></p>
  </article>

  <style>
    /* Every vertical measurement here is a whole multiple of --grid (32px):
       line-heights, margins, padding, gaps. That is what lets the snapper
       land a block on a line and keep everything below it on lines too — a
       half-row anywhere puts the next sibling on the wrong side of the
       rounding and the gap collapses. Where a border eats into a whole row,
       the row pays for it out of its own padding (calc(... - 1px)). */

    /* Type follows the homepage's rule: --font-heading (Cormorant) for
       headings and UI, --font-body (Lora) for prose. Without these the whole
       page inherits Lora from `body` and reads as a different site. */
    .back {
      display: inline-block;
      font-family: var(--font-heading);
      font-size: var(--text-xl);
      line-height: var(--grid);
      transition: transform 0.2s ease, filter 0.2s ease;
    }
    .back:hover { transform: translateX(-4px); }
    article h1 {
      margin: var(--grid) 0;
      font-family: var(--font-heading);
      font-size: var(--text-xl);
      line-height: var(--grid);
      color: var(--cream);
      font-weight: 400;
    }
    /* the lede — the counterpart of p.intro on the homepage, so it takes the
       same face and size */
    .summary {
      color: var(--muted);
      margin-bottom: var(--grid);
      font-family: var(--font-heading);
      font-size: var(--text-lg);
      line-height: var(--grid);
    }
    /* labeled metadata row under the title — 4-column grid.
       minmax(0, 1fr) lets columns shrink so long values wrap instead of
       overflowing; without it, tracks default to min-content and push wide.
       Each cell is dt + dd = two rows; the row gap is one more. */
    .meta-block {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--grid) var(--grid);
      margin: 0 0 calc(var(--grid) * 2);
      padding-bottom: calc(var(--grid) - 1px);
      border-bottom: 1px solid var(--color-divider);
    }
    /* same treatment as .section-label / .aside-label on the homepage —
       uppercase and letterspaced, which is what makes Cormorant hold up at
       label sizes */
    .meta-block dt {
      font-family: var(--font-heading); font-weight: 600;
      font-size: var(--text-sm);
      letter-spacing: 0.16em; text-transform: uppercase;
      line-height: var(--grid);
      color: rgba(var(--ink-rgb), 0.5);
      margin: 0;
    }
    .meta-block dd {
      margin: 0;
      font-size: var(--text-base);
      line-height: var(--grid);
      color: var(--cream);
      overflow-wrap: break-word;
    }

    /* --- project page content (markdown) ---
       No h1 rule here: the title above is the page's only h1, and a :global
       one would tie on specificity and win on source order. */
    article :global(h2) {
      font-family: var(--font-heading);
      font-size: 26px;
      line-height: var(--grid);
      color: rgb(var(--ink-rgb));
      margin: calc(var(--grid) * 2) 0 var(--grid);
      font-weight: 500;
    }
    article :global(h3) {
      font-family: var(--font-heading);
      font-size: var(--text-lg);
      line-height: var(--grid);
      color: rgb(var(--ink-rgb));
      margin: var(--grid) 0 0;
    }
    article :global(h4) {
      font-family: var(--font-heading);
      font-size: var(--text-lg);
      line-height: var(--grid);
      color: var(--muted);
      margin: var(--grid) 0 0;
      font-weight: 500;
    }
    article :global(p),
    article :global(li) {
      font-size: var(--text-base);
      line-height: var(--grid);
      color: var(--cream);
    }
    article :global(p) { margin: 0 0 var(--grid); }
    article :global(ul),
    article :global(ol) { margin: 0 0 var(--grid); padding-left: var(--grid); }
    /* the company/duration blurb under the title */
    article :global(.meta) {
      font-size: var(--text-base);
      line-height: var(--grid);
      color: var(--muted);
      margin-bottom: var(--grid);
    }
    /* the box is a whole number of rows: half a row of padding top and
       bottom, each minus the 1px border it sits inside. */
    article :global(.callout) {
      border: 1px solid var(--color-divider);
      padding: calc(var(--grid) / 2 - 1px) calc(var(--grid) / 2);
      margin: 0 0 var(--grid);
    }
    article :global(.callout p) {
      font-size: var(--text-base);
    }
    article :global(.callout > *:last-child) { margin-bottom: 0; }

    article :global(img) {
      max-width: 100%;
      width: 100%;
      height: auto;
      display: block;
      margin: var(--grid) 0;
      /* border: 1px solid rgba(238, 224, 224, 0.08); */
      /* border-radius: 2px; */
    }
    article :global(figure) {
      margin: var(--grid) 0;
    }
    article :global(figcaption) {
      font-size: var(--text-sm);
      line-height: var(--grid);
      color: var(--muted);
    }
    article :global(.cols-3) {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--grid);
    }
    /* inline pixel icons (fill="currentColor") — the accent is reserved for
       these and for clickable things. One grid row tall so the icon occupies
       a whole row; auto side margins center it in its callout. */
    article :global(.minisvg) {
      width: var(--grid);
      height: var(--grid);
      display: block;
      margin: 0 auto var(--grid);
      color: var(--gold);
    }

    /* the challenge heading: icon + label on one line */
    article :global(.challenge-head) {
      display: flex;
      align-items: center;
      gap: 0.4em;
    }
    /* inline variant — small, sits with the text, no centering.
       compound selector so it beats the base .minisvg regardless of order. */
    article :global(.minisvg.minisvg--inline) {
      width: 1.1em;
      height: 1.1em;
      display: inline-block;
      margin: 0;
      flex: none;
    }

    /* end-of-page navigation */
    .case-footer {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--grid);
      margin-top: calc(var(--grid) * 2);
      padding-top: calc(var(--grid) - 1px);
      border-top: 1px solid var(--color-divider);
      font-family: var(--font-heading);
      font-size: 16px;
      line-height: var(--grid);
    }
    .case-footer__next { text-align: right; }
    .case-cta {
      font-size: var(--text-base);
      line-height: var(--grid);
      color: var(--muted);
      margin: var(--grid) 0 0;
    }

    @media (max-width: 640px) {
      .meta-block { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      article :global(.cols-3) { grid-template-columns: 1fr; }
      .case-footer { flex-direction: column; gap: 0; }
      .case-footer__next { text-align: left; }
    }
  </style>
</BaseLayout>